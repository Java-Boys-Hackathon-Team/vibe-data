# Скопируй в .env рядом с docker-compose.yml и подставь значения.
# Любой ключ можно оставить заглушкой: приложение поднимется, не работать будут
# только обращения к соответствующему сервису.

# Адрес API, совместимого с OpenAI, и ключ к нему.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=<ключ OpenAI или совместимого шлюза>

LLM_TIMEOUT_SECONDS=60
PROCESSING_MAX_TOTAL_MS=600000
